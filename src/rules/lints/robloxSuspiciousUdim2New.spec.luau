local test = require("@std/test")

local lintSource = require("../../lib/lintSource")
local rule = require("./robloxSuspiciousUdim2New")

test.suite("roblox_suspicious_udim2_new", function(suite)
	suite:case("flags one argument, with a fromScale hint when it's between 0 and 1", function(assert)
		local violations = lintSource(rule, "UDim2.new(0.5)")
		assert.eq(#violations, 1)
		assert.strContains(violations[1].message, "1 was provided")
		assert.strContains(violations[1].message, "UDim2.fromScale instead")
	end)

	suite:case("flags one argument, with a fromOffset hint when it's outside 0 and 1", function(assert)
		local violations = lintSource(rule, "UDim2.new(2)")
		assert.eq(#violations, 1)
		assert.strContains(violations[1].message, "UDim2.fromOffset instead")
	end)

	suite:case("flags two numbers with a hint", function(assert)
		local violations = lintSource(rule, "UDim2.new(1, 1)")
		assert.eq(#violations, 1)
		assert.strContains(violations[1].message, "2 were provided")
		assert.strContains(violations[1].message, "UDim2.fromScale instead")
		assert.strContains(lintSource(rule, "UDim2.new(1, 2)")[1].message, "UDim2.fromOffset instead")
	end)

	suite:case("flags three arguments without a hint", function(assert)
		local violations = lintSource(rule, "UDim2.new(1, 1, 1)")
		assert.eq(#violations, 1)
		assert.strContains(violations[1].message, "3 were provided")
		assert.eq(violations[1].message:find("instead", 1, true), nil)
	end)

	suite:case("flags a mix of numbers and names without a hint", function(assert)
		local violations = lintSource(rule, "UDim2.new(1, a)")
		assert.eq(#violations, 1)
		assert.eq(violations[1].message:find("instead", 1, true), nil)
	end)

	suite:case("flags a single non-number argument without a hint", function(assert)
		local violations = lintSource(rule, "UDim2.new(a)")
		assert.eq(#violations, 1)
		assert.strContains(violations[1].message, "1 was provided")
		assert.eq(violations[1].message:find("instead", 1, true), nil)
	end)

	suite:case("flags a negative literal without a hint, since it isn't a number literal", function(assert)
		local violations = lintSource(rule, "UDim2.new(-1)")
		assert.eq(#violations, 1)
		assert.eq(violations[1].message:find("instead", 1, true), nil)
	end)

	suite:case("flags a call statement and a call nested in an expression", function(assert)
		assert.eq(#lintSource(rule, "UDim2.new(0)"), 1)
		assert.eq(#lintSource(rule, "local size = UDim2.new(1, 1, 1)"), 1)
	end)

	suite:case("leaves a call or varargs in the last place alone, since it can supply the rest", function(assert)
		assert.eq(#lintSource(rule, "local size = UDim2.new(parts())"), 0)
		assert.eq(#lintSource(rule, "local size = UDim2.new(0, offsets())"), 0)
		assert.eq(#lintSource(rule, "local size = UDim2.new(...)"), 0)
	end)

	suite:case("flags a parenthesized call in the last place, which gives one value", function(assert)
		assert.eq(#lintSource(rule, "local size = UDim2.new(0, (offsets()))"), 1)
	end)

	suite:case("leaves two non-number arguments alone", function(assert)
		assert.eq(#lintSource(rule, "UDim2.new(a, b)"), 0)
		assert.eq(#lintSource(rule, "UDim2.new(UDim.new(), UDim.new())"), 0)
	end)

	suite:case("leaves zero arguments and four or more alone", function(assert)
		assert.eq(#lintSource(rule, "UDim2.new()"), 0)
		assert.eq(#lintSource(rule, "UDim2.new(1, 1, 1, 1)"), 0)
		assert.eq(#lintSource(rule, "UDim2.new(a, b, c, d)"), 0)
	end)

	suite:case("leaves the helpers and other calls alone", function(assert)
		assert.eq(#lintSource(rule, "UDim2.fromScale(1)"), 0)
		assert.eq(#lintSource(rule, "UDim2:new(1)"), 0)
		assert.eq(#lintSource(rule, "UDim.new(1)"), 0)
	end)

	suite:case("leaves a local named UDim2 alone", function(assert)
		assert.eq(#lintSource(rule, "local UDim2 = {}\nUDim2.new(1)"), 0)
	end)
end)
